# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4100

# Matches docker-compose.yml defaults
DATABASE_URL=postgresql://ecom:ecom@localhost:5432/ecom?schema=public

# JWT — generate long random strings, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Paystack — TEST MODE keys only (sk_test_...). Secret key stays server-side.
PAYSTACK_SECRET_KEY=sk_test_replace-me
PAYSTACK_CALLBACK_URL=http://localhost:4100/payments/callback

# Cloudinary (signed uploads)
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me
