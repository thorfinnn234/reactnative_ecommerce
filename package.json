{
  "name": "reactnative-ecommerce",
  "private": true,
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:api": "pnpm --filter @ecom/api dev",
    "dev:admin": "pnpm --filter @ecom/admin dev",
    "dev:mobile": "pnpm --filter @ecom/mobile dev",
    "build": "pnpm --filter @ecom/shared build && pnpm --filter \"./apps/*\" build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "prisma": "pnpm --filter @ecom/api exec prisma",
    "db:migrate": "pnpm --filter @ecom/api db:migrate",
    "db:seed": "pnpm --filter @ecom/api db:seed",
    "db:studio": "pnpm --filter @ecom/api db:studio",
    "db:reset": "pnpm --filter @ecom/api db:reset"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0"
  }
}
